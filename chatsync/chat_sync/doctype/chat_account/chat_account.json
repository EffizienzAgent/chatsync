{
 "doctype": "DocType",
 "name": "Chat Account",
 "module": "Chat Sync",
 "engine": "InnoDB",
 "custom": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "user",
  "base_url",
  "access_token",
  "enabled",
  "initial_sync_done",
  "last_synced_at",
  "last_error",
  "ignored_chats",
  "excluded_groups"
 ],
 "fields": [
  {
   "fieldname": "user",
   "fieldtype": "Link",
   "label": "User",
   "options": "User",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "base_url",
   "fieldtype": "Data",
   "label": "Base URL",
   "reqd": 1
  },
  {
   "fieldname": "access_token",
   "fieldtype": "Password",
   "label": "Access Token",
   "reqd": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1"
  },
  {
   "fieldname": "initial_sync_done",
   "fieldtype": "Check",
   "label": "Initial Sync Done"
  },
  {
   "fieldname": "last_synced_at",
   "fieldtype": "Datetime",
   "label": "Last Synced At"
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Small Text",
   "label": "Last Error",
   "read_only": 1
  },
  {
   "fieldname": "ignored_chats",
   "fieldtype": "Long Text",
   "label": "Ignored Chats",
   "hidden": 1,
   "read_only": 1,
   "description": "Beeper chat IDs the user chose to ignore among unassigned chats"
  },
  {
   "fieldname": "excluded_groups",
   "fieldtype": "Long Text",
   "label": "Excluded Groups",
   "hidden": 1,
   "read_only": 1,
   "description": "Beeper group chat IDs that were unassigned and are not offered again"
  }
 ],
 "autoname": "field:user",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Chat User",
   "read": 1
  }
 ]
}
